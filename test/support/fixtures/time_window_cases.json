[
  {
    "name": "daily window",
    "toml": "when = { from = \"08:00\", until = \"15:00\" }",
    "checks": [["2027-01-04T07:59", false], ["2027-01-04T08:00", true], ["2027-01-04T14:59", true], ["2027-01-04T15:00", false]]
  },
  {
    "name": "overnight belongs to the day it started",
    "toml": "when = { days = \"fri\", from = \"22:00\", until = \"06:00\" }",
    "checks": [["2027-01-08T21:59", false], ["2027-01-08T22:00", true], ["2027-01-09T05:59", true], ["2027-01-09T06:00", false], ["2027-01-09T23:00", false], ["2027-01-08T03:00", false]]
  },
  {
    "name": "from only, until only, until 24:00",
    "toml": "when = [{ from = \"23:00\" }, { until = \"01:00\" }, { days = \"sun\", from = \"12:00\", until = \"24:00\" }]",
    "checks": [["2027-01-04T23:30", true], ["2027-01-04T00:30", true], ["2027-01-04T12:00", false], ["2027-01-10T23:59", true], ["2027-01-10T12:00", true]]
  },
  {
