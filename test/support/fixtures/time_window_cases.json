    "checks": [["2027-01-02T03:59", false], ["2027-01-02T04:00", true], ["2027-01-02T23:00", true], ["2027-01-03T09:59", true], ["2027-01-03T10:00", false]]
  },
  {
    "name": "open-ended periods and dates without time",
