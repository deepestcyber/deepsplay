[
  {
    "name": "nothing set",
    "toml": "description = \"Cells.\"",
    "expect": {"authors": [], "credits": null, "license": null}
  },
  {
    "name": "one author, credits and license, trimmed",
    "toml": "author = \"  Ada Lovelace \"\ncredits = \" Radar: Deutscher Wetterdienst \"\nlicense = \"MIT\"",
    "expect": {"authors": ["Ada Lovelace"], "credits": "Radar: Deutscher Wetterdienst", "license": "MIT"}
  },
  {
    "name": "several authors, empty names dropped",
    "toml": "author = [\"Ada\", \"  \", \"Grace\"]",
    "expect": {"authors": ["Ada", "Grace"], "credits": null, "license": null}
  },
  {
    "name": "empty texts count as not set",
    "toml": "author = \"\"\ncredits = \"  \"\nlicense = \"\"",
    "expect": {"authors": [], "credits": null, "license": null}
  },
  {
    "name": "invalid values are dropped",
    "toml": "author = 3\ncredits = [\"x\"]\nlicense = true",
    "expect": {"authors": [], "credits": null, "license": null},
    "warnings": 3
  },
  {
    "name": "too long values are dropped, other names kept",
    "toml": "author = [\"Ada\", \"LONGNAME\"]\nlicense = \"LONGLICENSE\"",
    "long": {"LONGNAME": 201, "LONGLICENSE": 101},
    "expect": {"authors": ["Ada"], "credits": null, "license": null},
    "warnings": 2
  }
]
